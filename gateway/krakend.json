{
  "$schema": "https://www.krakend.io/schema/v2.7/krakend.json",
  "version": 3,
  "name": "CanDroneX API Gateway",
  "port": 8080,
  "timeout": "5s",
  "output_encoding": "no-op",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "*"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "allow_headers": [
        "Authorization",
        "Content-Type",
        "Idempotency-Key",
        "X-Correlation-Id"
      ],
      "expose_headers": [
        "X-Correlation-Id",
        "Location"
      ],
      "max_age": "12h"
    },
    "telemetry/logging": {
      "level": "WARNING",
      "prefix": "[KRAKEND]",
      "stdout": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/drone-management/v1/drone",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "Content-Type",
        "Idempotency-Key",
        "X-Correlation-Id",
        "X-Client-Id"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://upstream-proxy:8000"
          ],
          "url_pattern": "/api/drone-management/v1/drone",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/candronex/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "http://localhost:8081/realms/candronex",
          "audience": [
            "candronex-api"
          ],
          "cache": true,
          "propagate_claims": [
            [
              "azp",
              "X-Client-Id"
            ]
          ]
        }
      }
    },
    {
      "endpoint": "/api/drone-management/v1/drone",
      "method": "GET",
      "input_headers": [
