          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/candronex/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "http://localhost:8081/realms/candronex",
          "audience": [
            "candronex-api"
          ],
          "cache": true,
          "propagate_claims": [
            [
              "azp",
              "X-Client-Id"
            ]
          ]
        }
      }
    },
    {
      "endpoint": "/api/drone-management/v1/drone/{droneId}",
